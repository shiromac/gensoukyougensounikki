
$>9000
	$>FullNameBase
		天狗風のワナ
	$<
	$>ShortNameBase
		$?FullNameBase
	$<
	$>shortExplanationBase
		#cdNOTICE
		踏むと別の部屋に飛ばされる。
		#n#i
		別の部屋がない場合は同じ部屋の別の場所に飛ばされる。
	$<
	$>longExplanationBase
		天狗風の罠（てんぐかぜのわな）
		#n
		#cdNOTICE
		踏むと別の部屋に飛ばされる。
		#n#i
		別の部屋がない場合は
		#n
		同じ部屋の別の場所に飛ばされる。
		#n
		道具が上に落ちると同じく飛ばされる。
		#n
		#n
		天狗風とは天狗が通った後に起こる
		#n
		突然激しく吹き降ろすつむじ風のことを言う。
		#n
		天狗風に人がさらわれた話もある。危険。
		#n
		でかいやつは巨木を丸ごと一本持っていってしまうようだ。
	$<
