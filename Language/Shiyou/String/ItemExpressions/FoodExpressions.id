
$>4000
	$>FullNameBase
		コッペパン
	$<
	$>ShortNameBase
		$?FullNameBase
	$<
	$>shortExplanationBase
		$?FullNameBase
		。
		美鈴の主食？
		#n
		#cdNOTICE
		食べると満腹度が
		中くらい回復する。
		#n
		ついでに元気、頑強状態になる。
	$<
	$>longExplanationBase
		$?FullNameBase
		。
		(こっぺぱん)
		#n
		紡錘形で底の平たいパン。
		#n
		一食分にするには少し大きさが心もとない。
		#n
		#n
		#cdNOTICE
		食べると満腹度が
		#*Value0
		回復する。
		#i
		#n
		満腹度が最大の時は、最大満腹度が
		#*Value1
		増える。
		#n
		ついでに
		#*Value3
		ターン元気、頑強状態（強度
		#*Value2
		）になる。
		#n
		#n
		美鈴の主食との噂だがはてさて。
	$<
$<
